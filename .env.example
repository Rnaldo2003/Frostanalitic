# Copia este archivo a .env y pon tus valores reales.
# El archivo .env NUNCA se sube a git (ya esta en .gitignore).

# Cadena de conexion completa (opcional). Si la defines, tiene prioridad
# sobre todo lo demas. Railway la inyecta automaticamente en produccion.
# DATABASE_URL=mysql+pymysql://root:tu_password@localhost/frostanalitic

# O, mas simple para desarrollo local, solo tu password de MySQL root:
LOCAL_DB_PASSWORD=tu_password_aqui

# Modo debug de Flask: "true" SOLO en tu maquina local, nunca en produccion.
FLASK_DEBUG=true

PORT=5000
